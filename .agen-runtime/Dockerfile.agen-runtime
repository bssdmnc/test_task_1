FROM php:8.4-cli

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends     git     ca-certificates     curl     jq     ripgrep     unzip     libzip-dev     libicu-dev     libbrotli-dev     libssl-dev wget && docker-php-ext-install bcmath intl zip && pecl install brotli && docker-php-ext-enable brotli sodium && rm -rf /var/lib/apt/lists/* /tmp/pear

RUN check_min() {       tool=$1 ; min=$2 ; actual=$3 ; ok=$(awk "BEGIN{ split(\"$actual\",a,\".\") ; split(\"$min\",m,\".\") ; for(i=1 ; i<=3 ; i++){ if(a[i]+0>m[i]+0){print 1 ; exit} if(a[i]+0<m[i]+0){print 0 ; exit} } ; print 1}") ; if [ "$ok" -ne 1 ] ; then         echo "FAIL: $tool $actual < minimum $min" >&2 ; exit 1 ; fi ; echo "OK: $tool $actual >= $min" ; } ; check_min git 2.25.0 "$(git --version | awk '{print $3}')" && check_min curl 7.70.0 "$(curl --version | head -1 | awk '{print $2}')" && check_min jq 1.6 "$(jq --version | sed 's/^jq-//')" && check_min rg 13.0.0 "$(rg --version | head -1 | awk '{print $2}')"

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

COPY . .

ENV COMPOSER_MEMORY_LIMIT=-1

RUN composer install --no-interaction --no-progress

# Regenerate autoload so newly-added dev namespaces (e.g. tests/fixture) resolve.
RUN composer dump-autoload --no-interaction

CMD ["sh", "-c", "php -dmemory_limit=-1 ./vendor/bin/phpunit -c config/phpunit.xml.dist"]
